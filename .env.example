# ════════════════════════════════════════════════════════════════
# FilmIQ — Environment Variables  (Firebase / Firestore edition)
# 1. Copy this file:  copy .env.example .env       (Windows)
#                     cp .env.example .env          (Mac/Linux)
# 2. Set your Firebase credentials (see options below)
# 3. Set ANTHROPIC_API_KEY
# 4. Change JWT_SECRET before going to production
# ════════════════════════════════════════════════════════════════

# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# ── Firebase Credentials (choose ONE option) ──────────────────────────────────
#
# Option A — Path to service-account JSON file (recommended for local dev)
#   1. Go to Firebase Console → Project Settings → Service Accounts
#   2. Click "Generate new private key" → save as backend/firebase-credentials.json
#   The default path is backend/firebase-credentials.json; override with:
# FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
#
# Option B — Inline JSON string (recommended for Docker / CI / Cloud Run)
#   Paste the entire contents of your service-account JSON as a single line:
# FIREBASE_CREDENTIALS={"type":"service_account","project_id":"...","private_key_id":"..."}
#
# Option C — Application Default Credentials (Cloud Run / GCE / gcloud auth)
#   Set your project ID only; credentials are picked up automatically:
# FIREBASE_PROJECT_ID=filmiq-prod

# ── Security (CHANGE IN PRODUCTION) ──────────────────────────────────────────
# Generate a secure secret: openssl rand -hex 64
JWT_SECRET=filmiq_jwt_dev_secret_change_in_production

# Default admin bootstrap account, created on first startup if no admin exists.
# The account is forced to change its password on first login — still, set a
# unique password here before deploying to production.
DEFAULT_ADMIN_EMAIL=admin@filmiq.africa
DEFAULT_ADMIN_PASSWORD=Admin@123

# ── Optional ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── TMDb (movie posters / backdrops) ─────────────────────────────────────────
# Get a free key at https://www.themoviedb.org/settings/api
# Accepts either a v3 API key or a v4 Bearer read-access token — both formats
# are auto-detected by backend/tmdb_service.py. If left blank, the app falls
# back to placeholder artwork everywhere images would otherwise appear.
TMDB_API_KEY=your_key_here
