# ════════════════════════════════════════════════════════════════
# FilmIQ — Environment Variables
# 1. Copy this file:  copy .env.example .env       (Windows)
#                     cp .env.example .env          (Mac/Linux)
# 2. Fill in ANTHROPIC_API_KEY at minimum
# 3. Change JWT_SECRET and DB_PASSWORD before going to production
# ════════════════════════════════════════════════════════════════

# ── Required ──────────────────────────────────────────────────────────────────
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# ── Database ──────────────────────────────────────────────────────────────────
DB_PASSWORD=filmiq_secret

# ── Security (CHANGE THESE IN PRODUCTION) ─────────────────────────────────────
# Generate a secure secret: openssl rand -hex 64
JWT_SECRET=filmiq_jwt_dev_secret_change_in_production

# ── Optional ──────────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
ANTHROPIC_MODEL=claude-sonnet-4-20250514
